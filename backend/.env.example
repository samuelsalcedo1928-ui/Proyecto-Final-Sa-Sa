# Copia este archivo como ".env" y llena los valores. El .env NUNCA se sube a GitHub.

PORT=3000

# Conexión a MongoDB Atlas (la sacas al crear el cluster gratis)
MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/nuevavida

# Clave larga para firmar el login del admin. Genera una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga

# Páginas que pueden llamar a la API, separadas por comas y sin "/" al final
CORS_ORIGIN=http://localhost:5173,https://samuelsalcedo1928-ui.github.io

# Buscador inteligente con Gemini (clave gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# "gemini-flash-latest" siempre apunta al modelo flash vigente.
# Si da error 404, corre "npm run modelos" para ver cuáles puede usar tu clave y pon uno aquí.
GEMINI_MODEL=gemini-flash-latest

# Solo para el script "npm run admin" (crear el administrador).
# Bórralos del .env cuando termines.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Aviso por correo cuando llega un mensaje de contacto (opcional)
# Cuenta gratis en https://resend.com. Sin la clave, el mensaje igual se guarda.
RESEND_API_KEY=
# Tu correo (el mismo con el que creaste la cuenta de Resend)
CORREO_AVISOS=samuelsalcedo1928@gmail.com
