# Copia como ".env" para trabajar en tu PC.
# En GitHub Pages estos valores van en Settings > Secrets and variables > Actions > Variables.

# Dirección del backend (en local o la de Render)
VITE_API_URL=http://localhost:3000

# WhatsApp de la tienda, con indicativo y sin signos
VITE_WHATSAPP=573052666891

# Contador de visitas sin cookies (opcional). Crea una cuenta gratis en goatcounter.com y pon aquí solo el código del sitio
# (si tu dirección es nuevavida.goatcounter.com, el código es: nuevavida). Vacío = no se cuenta nada.
VITE_GOATCOUNTER=

# Dirección secreta para entrar como administrador. Sin la barra del inicio. Ejemplo: gestion-nv-48271
# Se entra en: https://TU-PAGINA/#/gestion-nv-48271  (no hay ningún botón que lleve ahí).
# Si lo dejas vacío usa "acceso-privado". Pon aquí la tuya y la misma en Vercel (con Redeploy).
VITE_RUTA_ADMIN=
